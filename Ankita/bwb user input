"""
bwb_independent_upper_lower.py
===================================
EXACTLY as requested: TWO INDEPENDENT EQUATIONS -- one for the upper
surface, one for the lower surface -- each with their OWN parameters.
Camber and thickness are DERIVED afterward from these two surfaces
(not the other way around, and not built by adding/subtracting a
shared camber+thickness pair).

THE TWO EQUATIONS (this is the entire geometry definition):

    UPPER SURFACE:   y_u(xc) =  A_u * xc^n_u * (1 - xc)
    LOWER SURFACE:   y_l(xc) = -A_l * xc^n_l * (1 - xc)

    A_u, A_l : amplitude of each surface (how far it bulges/dips)
    n_u, n_l : loading exponent of each surface (where along the
               chord it peaks -- lower n = peak further forward,
               higher n = peak further aft)

These four numbers are set INDEPENDENTLY for the upper and lower
surface -- you can make them as different as you like (e.g. a strongly
bulging upper surface with a nearly flat lower surface).

WHAT EACH PARAMETER PHYSICALLY CONTROLS (verified numerically below):

    A_u (upper amplitude)  -> increases camber  -> INCREASES CL
                            -> increases thickness -> INCREASES CD0
    A_l (lower amplitude)  -> DECREASES camber (pulls yc down)
                            -> DECREASES CL
                            -> increases thickness -> INCREASES CD0
    n_u, n_l (loading position) -> shifts WHERE the camber-line slope
                            is concentrated -> secondary effect on CL
                            (aft-loading vs forward-loading), because
                            the thin-airfoil integral weights the
                            camber slope differently at different
                            chord stations.

HOW CL AND CD ARE ACTUALLY DERIVED FROM y_u, y_l:

    yc(xc)  = (y_u(xc) + y_l(xc)) / 2          <- derived, NOT input
    dyc/dx  = numerical derivative of yc(xc)     <- derived
    alpha_L0 = -(1/pi) * Integral_0^pi (dyc/dx)(cos(th)-1) dth  <- real
               thin-airfoil-theory integral (same one verified earlier
               against NACA 2412/4412 textbook values)
    CL = (2*pi*AR/(AR+2)) * (alpha - alpha_L0)

    thickness(xc) = y_u(xc) - y_l(xc)            <- derived
    wetted perimeter = real arc length of y_u(xc) and y_l(xc)
    CD0 = Cf * (A_wetted / S)
    CD_i = CL^2 / (pi*e*AR)
    CD = CD0 + CD_i

Run:
    python3 bwb_independent_upper_lower.py
"""

import numpy as np
import matplotlib.pyplot as plt
import matplotlib.colors as mcolors


def ask(prompt, default):
    raw = input(f"{prompt} [default {default}]: ").strip()
    return float(raw) if raw else default


# =============================================================================
# STEP 1: THE TWO INDEPENDENT SURFACE EQUATIONS -- direct parameter input
# =============================================================================
def y_upper(xc, A, n):
    """UPPER SURFACE -- its own equation, its own parameters."""
    return A * xc ** n * (1 - xc)


def y_lower(xc, A, n):
    """LOWER SURFACE -- a COMPLETELY SEPARATE equation, separate params."""
    return -A * xc ** n * (1 - xc)


print("=" * 74)
print("INDEPENDENT UPPER/LOWER SURFACE INPUT")
print("  y_upper(xc) =  A_u * xc^n_u * (1-xc)")
print("  y_lower(xc) = -A_l * xc^n_l * (1-xc)")
print("=" * 74)

print("\n--- CENTERBODY (inner) section ---")
AU_IN = ask("  Upper amplitude, A_u_inner", 0.10)
NU_IN = ask("  Upper loading exponent, n_u_inner (0.5=fwd peak, 2=aft peak)", 1.0)
AL_IN = ask("  Lower amplitude, A_l_inner", 0.06)
NL_IN = ask("  Lower loading exponent, n_l_inner", 1.0)

print("\n--- OUTER WING section ---")
AU_OUT = ask("  Upper amplitude, A_u_outer", 0.07)
NU_OUT = ask("  Upper loading exponent, n_u_outer", 1.0)
AL_OUT = ask("  Lower amplitude, A_l_outer", 0.045)
NL_OUT = ask("  Lower loading exponent, n_l_outer", 1.0)

print("\n--- Planform (span/chord/sweep -- cosmetic + AR only) ---")
INNER_SPAN = ask("Inner span (mm)", 22.0)
OUTER_SPAN = ask("Outer span (mm)", 70.0)
INNER_ROOT = ask("Inner root chord (mm)", 86.0)
INNER_TIP = ask("Inner tip chord (mm)", 56.0)
OUTER_ROOT = ask("Outer root chord (mm)", 56.0)
OUTER_TIP = ask("Outer tip chord (mm)", 15.0)
INNER_SWEEP = ask("Inner sweep (deg, cosmetic only)", 45.0)
OUTER_SWEEP = ask("Outer sweep (deg, cosmetic only)", 35.0)

print("\n--- Flight condition & drag model ---")
ALPHA_DEG = ask("Angle of attack, alpha (deg)", 0.0)
SPAN_EFFICIENCY = ask("Span efficiency, e (typical 0.7-0.95)", 0.85)
CF = ask("Skin-friction coefficient, Cf (typical 0.003-0.006)", 0.004)

HALF_SPAN = INNER_SPAN + OUTER_SPAN


# =============================================================================
# STEP 2: DERIVE camber yc(x) and its slope -- FROM y_u, y_l (not the reverse)
# =============================================================================
def camber_line(xc, Au, nu, Al, nl):
    """yc(xc) = (y_upper + y_lower)/2 -- DERIVED, never a direct input."""
    return (y_upper(xc, Au, nu) + y_lower(xc, Al, nl)) / 2.0


def camber_slope_numeric(xc, Au, nu, Al, nl, h=1e-5):
    """Numerical derivative of the DERIVED camber line."""
    return (camber_line(xc + h, Au, nu, Al, nl)
            - camber_line(xc - h, Au, nu, Al, nl)) / (2 * h)


def alpha_L0_from_surfaces(Au, nu, Al, nl, n=800):
    """Real thin-airfoil zero-lift angle, from the DERIVED camber line's
    real slope (same verified integral as before)."""
    theta = np.linspace(1e-6, np.pi - 1e-6, n)
    xc = 0.5 * (1 - np.cos(theta))
    dyc = camber_slope_numeric(xc, Au, nu, Al, nl)
    integrand = dyc * (np.cos(theta) - 1)
    integral = np.trapezoid(integrand, theta)
    return -integral / np.pi


alpha_L0_in = alpha_L0_from_surfaces(AU_IN, NU_IN, AL_IN, NL_IN)
alpha_L0_out = alpha_L0_from_surfaces(AU_OUT, NU_OUT, AL_OUT, NL_OUT)

print("\n" + "=" * 74)
print("DERIVED camber-line result (from your two independent surfaces)")
print("=" * 74)
print(f"Centerbody: alpha_L0 = {np.degrees(alpha_L0_in):.3f} deg")
print(f"Outer wing: alpha_L0 = {np.degrees(alpha_L0_out):.3f} deg")


# =============================================================================
# STEP 3: DERIVE wetted perimeter -- FROM y_u, y_l directly (real arc length)
# =============================================================================
def wetted_arc_length(Au, nu, Al, nl, n=400):
    xc = np.linspace(0, 1, n)
    yu = y_upper(xc, Au, nu)
    yl = y_lower(xc, Al, nl)
    len_u = np.sum(np.hypot(np.diff(xc), np.diff(yu)))
    len_l = np.sum(np.hypot(np.diff(xc), np.diff(yl)))
    return len_u + len_l


wetted_per_chord_in = wetted_arc_length(AU_IN, NU_IN, AL_IN, NL_IN)
wetted_per_chord_out = wetted_arc_length(AU_OUT, NU_OUT, AL_OUT, NL_OUT)

print(f"\nWetted perimeter/chord -- centerbody: {wetted_per_chord_in:.4f}")
print(f"Wetted perimeter/chord -- outer wing:  {wetted_per_chord_out:.4f}")


# =============================================================================
# STEP 4: PLANFORM (area, aspect ratio)
# =============================================================================
def panel_area(span, root, tip):
    return span * (root + tip) / 2.0


A_in = panel_area(INNER_SPAN, INNER_ROOT, INNER_TIP)
A_out = panel_area(OUTER_SPAN, OUTER_ROOT, OUTER_TIP)
S = A_in + A_out
AR = (2 * HALF_SPAN) ** 2 / (2 * S)

A_wetted = wetted_per_chord_in * A_in + wetted_per_chord_out * A_out


# =============================================================================
# STEP 5: FINAL CL, CD, L/D -- all derived from your two surface equations
# =============================================================================
alpha_L0_rad = (A_in * alpha_L0_in + A_out * alpha_L0_out) / S
alpha_rad = np.radians(ALPHA_DEG)

CL = (2 * np.pi * AR / (AR + 2)) * (alpha_rad - alpha_L0_rad)
CD0 = CF * (A_wetted / S)
CD_i = CL ** 2 / (np.pi * SPAN_EFFICIENCY * AR)
CD = CD0 + CD_i
LD = CL / CD if CD != 0 else float('nan')

print("\n" + "=" * 74)
print("FINAL RESULTS")
print("=" * 74)
print(f"S = {S:.1f} mm^2   AR = {AR:.3f}   A_wetted/S = {A_wetted/S:.3f}")
print(f"alpha_L0 (area-weighted) = {np.degrees(alpha_L0_rad):.3f} deg")
print(f"CL   = {CL:.4f}")
print(f"CD0  = {CD0:.4f}")
print(f"CD_i = {CD_i:.4f}")
print(f"CD   = {CD:.4f}")
print(f"L/D  = {LD:.2f}")
print("=" * 74)

print("\nWHICH PARAMETER TO CHANGE FOR WHAT EFFECT:")
print("  A_u_inner / A_u_outer  UP  -> CL up, CD0 up  (more upper bulge)")
print("  A_l_inner / A_l_outer  UP  -> CL down, CD0 up (more lower dip)")
print("  n_u, n_l  -> shifts WHERE the curve peaks -> secondary CL shift")
print("  (A_u == A_l and n_u == n_l)  -> zero camber -> CL from alpha only")


# =============================================================================
# STEP 6: VISUALIZE -- the two independent curves, CL/CD, and full 3D shape
# =============================================================================
def local_chord(y):
    ay = np.abs(y)
    inner = INNER_ROOT - (INNER_ROOT - INNER_TIP) * np.clip(ay / INNER_SPAN, 0, 1)
    outer = OUTER_ROOT - (OUTER_ROOT - OUTER_TIP) * \
        np.clip((ay - INNER_SPAN) / OUTER_SPAN, 0, 1)
    return np.where(ay <= INNER_SPAN, inner, outer)


def leading_edge_x(y):
    ay = np.abs(y)
    le_j = INNER_SPAN * np.tan(np.radians(INNER_SWEEP))
    inner_le = ay * np.tan(np.radians(INNER_SWEEP))
    outer_le = le_j + (ay - INNER_SPAN) * np.tan(np.radians(OUTER_SWEEP))
    return np.where(ay <= INNER_SPAN, inner_le, outer_le)


fig = plt.figure(figsize=(15, 6.5))

# --- Panel 1: the two INDEPENDENT curves you defined (centerbody) ---
ax1 = fig.add_subplot(1, 3, 1)
xc_plot = np.linspace(0, 1, 200)
yu_plot = y_upper(xc_plot, AU_IN, NU_IN)
yl_plot = y_lower(xc_plot, AL_IN, NL_IN)
yc_plot = (yu_plot + yl_plot) / 2
ax1.plot(xc_plot, yu_plot, color='#1355A6', linewidth=2.2,
           label='$y_u(x)$ -- YOUR upper equation')
ax1.plot(xc_plot, yl_plot, color='#B0281A', linewidth=2.2,
           label='$y_l(x)$ -- YOUR lower equation')
ax1.plot(xc_plot, yc_plot, '--', color='#0F6E56', linewidth=1.3,
           label='$y_c(x)$ -- DERIVED (not input)')
ax1.fill_between(xc_plot, yu_plot, yl_plot, alpha=0.15, color='#1355A6')
ax1.axhline(0, color='0.7', linewidth=0.6)
ax1.set_xlabel('x/c')
ax1.set_ylabel('y/c')
ax1.set_title(f'Centerbody: two independent surfaces\n'
                f'$A_u$={AU_IN}, $n_u$={NU_IN}  |  $A_l$={AL_IN}, $n_l$={NL_IN}',
                fontsize=10, weight='bold')
ax1.legend(fontsize=8.5, loc='upper right')
ax1.grid(alpha=0.3)

# --- Panel 2: CL/CD bar summary ---
ax2 = fig.add_subplot(1, 3, 2)
labels = ['$C_L$', '$C_{D,0}$', '$C_{D,i}$', '$C_D$']
values = [CL, CD0, CD_i, CD]
colors = ['#1355A6', '#8A929B', '#B0281A', '#0F6E56']
bars = ax2.bar(labels, values, color=colors, width=0.6)
ax2.bar_label(bars, fmt='%.4f', fontsize=10, weight='bold')
ax2.set_title(f'Derived from your surfaces\nL/D = {LD:.2f}', fontsize=11,
               weight='bold')
ax2.spines[['top', 'right']].set_visible(False)
ax2.set_ylim(0, max(values) * 1.3 if max(values) > 0 else 1)

# --- Panel 3: full 3D BWB shape ---
ax3 = fig.add_subplot(1, 3, 3, projection='3d')
n_span, n_chord = 80, 50
y_vals = np.linspace(-HALF_SPAN, HALF_SPAN, n_span)
xc_vals = np.linspace(0, 1, n_chord)
XC, Y = np.meshgrid(xc_vals, y_vals)
chord = local_chord(Y)
X = leading_edge_x(Y) + XC * chord

Zu = np.zeros_like(XC)
Zl = np.zeros_like(XC)
for i in range(n_span):
    frac = min(max(abs(y_vals[i]) / HALF_SPAN, 0), 1)
    au_i = AU_IN * (1 - frac) + AU_OUT * frac
    nu_i = NU_IN * (1 - frac) + NU_OUT * frac
    al_i = AL_IN * (1 - frac) + AL_OUT * frac
    nl_i = NL_IN * (1 - frac) + NL_OUT * frac
    Zu[i] = y_upper(XC[i], au_i, nu_i) * chord[i]
    Zl[i] = y_lower(XC[i], al_i, nl_i) * chord[i]

PITCH = np.radians(-14)


def pitch_rotate(Xp, Zp):
    return (Xp * np.cos(PITCH) + Zp * np.sin(PITCH),
            -Xp * np.sin(PITCH) + Zp * np.cos(PITCH))


Xu, Zu = pitch_rotate(X, Zu)
Xl, Zl = pitch_rotate(X, Zl)

_stops = [0.00, 0.15, 0.30, 0.45, 0.60, 0.75, 0.88, 1.00]
_colors = ['rgb(50,0,90)', 'rgb(60,0,140)', 'rgb(0,60,180)', 'rgb(0,160,200)',
           'rgb(0,210,130)', 'rgb(120,220,50)', 'rgb(240,220,20)',
           'rgb(255,180,0)']
_rgb = lambda s: tuple(int(n) / 255 for n in s[s.index('(') + 1:s.index(')')].split(','))
CMAP = mcolors.LinearSegmentedColormap.from_list('u', list(zip(_stops, [_rgb(c) for c in _colors])))
NORM = mcolors.Normalize(vmin=-0.15, vmax=0.15)

z_scale = max(abs(Zu).max(), abs(Zl).max(), 1e-6)
ax3.plot_surface(Xu, Y, Zu, facecolors=CMAP(NORM(Zu / z_scale)),
                   linewidth=0.1, edgecolor='0.3', antialiased=True, shade=False)
ax3.plot_surface(Xl, Y, Zl, facecolors=CMAP(NORM(Zl / z_scale)),
                   linewidth=0.1, edgecolor='0.3', antialiased=True, shade=False)
ax3.set_xlim(-20, 100)
ax3.set_ylim(-HALF_SPAN - 10, HALF_SPAN + 10)
ax3.set_zlim(-z_scale * 1.5, z_scale * 1.5)
ax3.set_box_aspect((12, 19, 6))
ax3.set_xticks([]); ax3.set_yticks([]); ax3.set_zticks([])
ax3.set_title('Full BWB from your two\nindependent surface equations',
               fontsize=11, weight='bold')
ax3.view_init(elev=22, azim=-58)
ax3.invert_xaxis()

plt.tight_layout()
plt.savefig('bwb_independent_upper_lower.png', dpi=155, facecolor='white',
            bbox_inches='tight')
print("\nSaved: bwb_independent_upper_lower.png")


